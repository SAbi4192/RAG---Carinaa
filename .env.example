# ===========================================================================
# Carinaa — environment configuration
#
# Copy this file to `.env` in the project root and fill in what you need:
#
#     cp .env.example .env
#
# EVERYTHING IS OPTIONAL EXCEPT `SECRET_KEY` IN PRODUCTION.
# Carinaa starts with no API keys at all: Offline mode works out of the box using
# the local model in ./models, and the landing page tells you what is missing.
# ===========================================================================


# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true

# REQUIRED in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-before-deploying

# Comma-separated. The Vite dev server origin is the default.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# ---------------------------------------------------------------------------
# Online AI — Groq is PRIMARY (fast LPU inference; tried first for every online answer)
# Get a key: https://aistudio.google.com/apikey
#
# This key stays on the server. It is never sent to the browser and never placed
# into a prompt.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key-here
# Verified Stable/GA at https://ai.google.dev/gemini-api/docs/models
# The Settings page lists live models, so you can change this without editing code.
GEMINI_MODEL=gemini-3.6-flash

# Gemini "thinking" models charge their reasoning tokens AGAINST maxOutputTokens.
# A long chain of thought can therefore truncate the visible answer, silently
# (HTTP 200 with finishReason=MAX_TOKENS). 0 disables thinking, which is right for
# translation and shortening; the allowance is added ON TOP of the output budget.
#   0  = disabled  (default)
#   >0 = explicit token allowance
#   -1 = let the model decide
# See docs/09_offline_and_online_modes.md.
GEMINI_THINKING_BUDGET=0

# ---------------------------------------------------------------------------
# Online AI — Gemini is the FALLBACK
# Get a key: https://console.groq.com/keys
#
# Used automatically when Groq is rate-limited or unavailable. The UI always
# discloses the fallback as "Gemini · Fallback" — it is never hidden.
# ---------------------------------------------------------------------------
GROQ_API_KEY=your-groq-api-key-here
# Verified Production at https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b


# ---------------------------------------------------------------------------
# Offline AI — local GGUF via llama.cpp
#
# No key needed. This is what makes Offline mode genuinely offline: no network
# request is made at any point. Change these only if you replace the model file.
# ---------------------------------------------------------------------------
LOCAL_MODEL_PATH=models/llm-model.gguf
LOCAL_MODEL_LABEL=Qwen2.5-3B-Instruct (Q4_K_M)
# Context window actually allocated. Larger = more RAM. 8192 is a good balance
# for a 3B model on a laptop; the model itself supports 32768.
LOCAL_N_CTX=8192
# 0 = auto-detect. Set to your physical core count if you want to be explicit.
LOCAL_N_THREADS=0
# 0 = pure CPU, which is the portable default. Set higher only if llama.cpp was
# built with GPU support.
LOCAL_N_GPU_LAYERS=0
LOCAL_MAX_TOKENS=1024

# When the local model cannot load, Offline mode produces a clearly-labelled
# extractive answer instead of failing. It NEVER falls back to an online provider.
OFFLINE_EXTRACTIVE_FAILSAFE=true


# ---------------------------------------------------------------------------
# Embeddings — local ONNX model, downloaded once
#
# Run this after installing dependencies:
#     .venv/Scripts/python scripts/fetch_models.py
#
# Multilingual (50+ languages), 384 dimensions, ~235 MB.
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_LOCAL_DIR=data/models/fastembed


# ---------------------------------------------------------------------------
# Retrieval
#
# candidate_k chunks are fetched from the vector index; the best top_k go to the
# language model. Fetching more than you use is nearly free.
# ---------------------------------------------------------------------------
TOP_K=5
CANDIDATE_K=20
# 0 disables the similarity floor. Raise it to be stricter about weak matches.
MIN_RELEVANCE_SCORE=0.0
MAX_CONTEXT_CHARS=12000

# Optional cross-encoder re-ranking. OFF by default, and it is NOT required for
# basic RAG. Remember: it can only reorder what retrieval already found.
RERANK_ENABLED=false
RERANK_TOP_N=5


# ---------------------------------------------------------------------------
# Chunking
# ---------------------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MIN_CHUNK_CHARS=80


# ---------------------------------------------------------------------------
# Grounding
# ---------------------------------------------------------------------------
GROUNDING_ENABLED=true
# How much of a claim sentence's vocabulary must appear in the excerpt it cites.
REQUIRE_CITATIONS=true
GROUNDING_MIN_OVERLAP=0.18


# ---------------------------------------------------------------------------
# Response experience
# ---------------------------------------------------------------------------
TRANSLATION_ENABLED=true
SHORTEN_ENABLED=true
READ_ALOUD_ENABLED=true
TRANSLATE_CACHE_ENABLED=true


# ---------------------------------------------------------------------------
# Web search — OPTIONAL, and OFF unless you explicitly turn it on
#
# Never activates implicitly. Always disabled in Offline mode. Document sources
# and web sources are always shown separately.
# ---------------------------------------------------------------------------
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5


# ---------------------------------------------------------------------------
# Defaults
# ---------------------------------------------------------------------------
DEFAULT_AI_MODE=online
MAX_UPLOAD_MB=50
MAX_DOCUMENTS_PER_WORKSPACE=500
MAX_WORKSPACES_PER_USER=50
