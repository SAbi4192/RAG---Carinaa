# ---------------------------------------------------------------------------
# Secrets - NEVER commit these
# ---------------------------------------------------------------------------
# .env holds real API keys. .env.example is the safe template and IS committed.
.env
.env.*
!.env.example
*.pem
*.key

# ---------------------------------------------------------------------------
# Runtime data - regenerated by running the app
# ---------------------------------------------------------------------------
# The database, uploaded documents, the vector index and logs. All of it can be
# rebuilt from the original files, and none of it belongs in version control -
# uploads may contain private documents.
data/
!data/.gitkeep

# Model weights. The GGUF is ~2 GB; it is downloaded/placed locally, not committed.
models/
*.gguf
*.onnx

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# ---------------------------------------------------------------------------
# Node / frontend
# ---------------------------------------------------------------------------
node_modules/
frontend/dist/
.vite/
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Editors and OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
